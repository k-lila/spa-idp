# Copie para .env.local (ignorado pelo git) e ajuste por ambiente.
# Valores abaixo apontam para o IdP fake local: `npm run idp`.
# Para o IdP real local: VITE_OIDC_ISSUER=http://localhost:8000/o e o client_id da
# Application de dev (contrato-frontend §6.1).

# Base do discovery OIDC, sem barra final. O sufixo /o espelha o IdP real.
VITE_OIDC_ISSUER=http://localhost:9000/o
# client_id público registrado no IdP (no fake: dev/idp-fake/server.js).
VITE_OIDC_CLIENT_ID=spa-local
# URL de /callback deste deploy; igualdade exata com a registrada no IdP.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
