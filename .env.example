# Copie para .env.local (ignorado pelo git) e ajuste por ambiente.
# Valores abaixo apontam para o IdP fake local: `npm run idp`.
# Para o IdP real local (`docs/contrato-idp.md` §1 e §2), que só aceita redirect https:
#   VITE_OIDC_ISSUER=https://localhost/o
#   VITE_OIDC_CLIENT_ID=<client_id da Application de dev>
#   VITE_OIDC_REDIRECT_URI=https://localhost:5173/callback
#   VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://localhost:5173/
# e a SPA servida em https com o certificado do `mkcert localhost`, fora do repositório
# (só lidos pelo vite.config.ts; sem prefixo VITE_, não vão ao bundle):
#   SPA_DEV_TLS_CERT=/home/<voce>/.config/spa-dev-tls/localhost.pem
#   SPA_DEV_TLS_KEY=/home/<voce>/.config/spa-dev-tls/localhost-key.pem

# Base do discovery OIDC, sem barra final. O sufixo /o espelha o IdP real.
VITE_OIDC_ISSUER=http://localhost:9000/o
# client_id público registrado no IdP (no fake: dev/idp-fake/server.js).
VITE_OIDC_CLIENT_ID=spa-local
# URL de /callback deste deploy; igualdade exata com a registrada no IdP.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
# Landing deste deploy, destino da volta do "Sair"; igualdade exata com o
# post_logout_redirect_uri registrado no IdP (ADR 0019).
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
